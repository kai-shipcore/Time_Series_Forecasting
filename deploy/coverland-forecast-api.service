# Reference copy of the systemd unit installed at
#   /etc/systemd/system/coverland-forecast-api.service
#
# The live file is NOT deployed from here: the deploy's rsync does not touch
# /etc, and the deploy user has passwordless sudo only for restarting this unit,
# not for writing unit files. This copy exists so the configuration is in version
# control and a rebuilt server can be made to match, rather than the only record
# being a file on one machine.
#
# --host 0.0.0.0 is load-bearing (2026-08-07). Loopback makes the API
# unreachable from any other machine, which is what the "port 8000 is
# firewalled" confusion in DEPLOYMENT.md was actually about. 0.0.0.0 includes
# loopback, so the Next.js app beside it keeps working unchanged.
#
# If you change the live file, change this one in the same commit.

[Unit]
Description=Coverland Forecast API
After=network.target

[Service]
User=coverland
WorkingDirectory=/opt/coverland-forecast-api
EnvironmentFile=/opt/coverland-forecast-api/.env
ExecStart=/opt/coverland-forecast-api/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
